---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import BackNav from '../components/BackNav.astro';
import { readingTime } from '../lib/reading-time';
import { site } from '../lib/site';
import '../styles/article.css';

interface Props {
  entry: CollectionEntry<'notas'>;
}

const { entry } = Astro.props;
const { titulo, fecha, resumen } = entry.data;
const { Content } = await render(entry);
const minutos = readingTime(entry.body ?? '');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: titulo,
  description: resumen,
  datePublished: fecha.toISOString(),
  author: { '@type': 'Person', name: site.name, url: site.github },
};
---

<BaseLayout title={`${titulo} — ${site.name}`} description={resumen} jsonLd={jsonLd}>
  <BackNav slot="nav" />

  <article class="container">
    <div class="title-block">
      <div class="meta">
        <time datetime={fecha.toISOString()}>
          {fecha.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        · {minutos} min de lectura
      </div>
      <h1>{titulo}</h1>
      <p class="dek">{resumen}</p>
    </div>

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .title-block {
    max-width: var(--col-text);
    /* 112px/64px: valores literales del mockup, fuera de la escala de 9 pasos */
    padding: 112px 0 64px;
    margin: 0 auto;
  }

  .meta {
    font-family: var(--font-mono);
    font-size: var(--fs-13);
    color: var(--color-meta);
    margin-bottom: var(--space-3);
  }

  h1 {
    font-size: var(--fs-49);
    line-height: var(--lh-heading-lg);
  }

  .dek {
    font-family: var(--font-body);
    font-size: var(--fs-20);
    line-height: var(--lh-body-lg);
    color: var(--color-ink-body);
    margin-top: var(--space-4);
  }

  .prose {
    margin: 0 auto var(--space-8);
  }

  @media (max-width: 768px) {
    .title-block {
      padding-top: var(--space-6);
    }

    h1 {
      font-size: var(--fs-39);
    }
  }
</style>

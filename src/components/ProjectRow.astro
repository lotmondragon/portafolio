---
import type { CollectionEntry } from 'astro:content';
import { projectSlug } from '../lib/projects';

interface Props {
  entry: CollectionEntry<'proyectos'>;
}

const { entry } = Astro.props;
const { titulo, numero, resumen, anio, stack } = entry.data;

/** Onda de firma: una polilínea distinta y estable por proyecto, derivada
 * del slug. Generada en build, cero JS de cliente. No es aleatoria en el
 * sentido de "cambia cada visita" — es determinística, como una huella. */
function signaturePoints(seed: string, count = 14, width = 120, height = 20): string {
  let h = 0;
  for (let i = 0; i < seed.length; i++) h = (Math.imul(h, 31) + seed.charCodeAt(i)) >>> 0;
  const next = () => {
    h = (Math.imul(h, 1664525) + 1013904223) >>> 0;
    return h / 4294967296;
  };
  const step = width / (count - 1);
  const pts: string[] = [];
  for (let i = 0; i < count; i++) {
    pts.push(`${Math.round(i * step)},${Math.round(2 + next() * (height - 4))}`);
  }
  return pts.join(' ');
}

const signature = signaturePoints(entry.id);
---

<a class="row" href={`/proyectos/${projectSlug(entry.id)}/`}>
  <span class="num"><span class="bracket bracket-open" aria-hidden="true">[</span>{numero}<span class="bracket bracket-close" aria-hidden="true">]</span></span>
  <span class="body">
    <span class="name">{titulo}</span>
    <span class="desc">{resumen}</span>
    <span class="stack-line">
      <span class="stack">{stack.join(' · ')}</span>
      <svg class="signature" viewBox="0 0 120 20" preserveAspectRatio="none" aria-hidden="true">
        <polyline points={signature} fill="none" stroke="currentColor" stroke-width="1.25" />
      </svg>
    </span>
  </span>
  <span class="year">{anio}</span>
</a>

<style>
  .row {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    grid-template-areas: 'num body year';
    column-gap: var(--space-3);
    padding: var(--space-4) var(--space-2);
    margin: 0 calc(var(--space-2) * -1);
    border-top: 1px solid var(--color-border);
    color: inherit;
    transition: background var(--duration-color) var(--ease);
  }

  .num {
    grid-area: num;
  }

  .body {
    grid-area: body;
  }

  .year {
    grid-area: year;
  }

  .row:hover {
    background: var(--color-row-hover);
  }

  .num,
  .year {
    font-family: var(--font-mono);
    font-size: var(--fs-13);
    color: var(--color-meta);
    padding-top: 6px;
  }

  .num {
    position: relative;
    transition: color var(--duration-color) var(--ease);
  }

  .row:hover .num {
    color: var(--color-accent);
  }

  .bracket {
    display: inline-block;
    color: var(--color-accent);
    opacity: 0;
    transition:
      opacity var(--duration-color) var(--ease),
      transform var(--duration-color) var(--ease);
  }

  .bracket-open {
    transform: translateX(6px);
  }

  .bracket-close {
    transform: translateX(-6px);
  }

  .row:hover .bracket {
    opacity: 1;
    transform: translateX(0);
  }

  .year {
    text-align: right;
  }

  .body {
    min-width: 0;
  }

  .name {
    display: block;
    font-family: var(--font-display);
    font-size: var(--fs-25);
    line-height: var(--lh-heading-sm);
    color: var(--color-ink);
  }

  .desc {
    display: block;
    font-family: var(--font-body);
    font-size: var(--fs-16);
    line-height: var(--lh-body-tight);
    color: var(--color-ink-desc);
    margin-top: var(--space-2);
    max-width: 64ch;
  }

  .stack-line {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .stack {
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    letter-spacing: 0.03em;
    color: var(--color-meta);
  }

  .signature {
    width: 72px;
    height: 14px;
    flex-shrink: 0;
    color: var(--color-accent);
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity var(--duration-opacity) var(--ease),
      transform var(--duration-opacity) var(--ease);
  }

  .row:hover .signature {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 768px) {
    .row {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'num year'
        'body body';
      row-gap: var(--space-1);
    }

    .signature {
      display: none;
    }
  }
</style>

---
import type { CollectionEntry } from 'astro:content';
import { readingTime } from '../lib/reading-time';

interface Props {
  entry: CollectionEntry<'notas'>;
}

const { entry } = Astro.props;
const { titulo, fecha, resumen } = entry.data;
const minutos = readingTime(entry.body ?? '');
const meta = `${fecha.getFullYear()} · ${minutos} min`;
---

<a class="row" href={`/notas/${entry.id}/`}>
  <div class="head">
    <span class="title">{titulo}</span>
    <span class="meta">{meta}</span>
  </div>
  <p class="summary">{resumen}</p>
</a>

<style>
  .row {
    display: block;
    color: inherit;
    padding: var(--space-3) var(--space-2);
    margin: 0 calc(var(--space-2) * -1);
    border-top: 1px solid var(--color-border);
    transition: background var(--duration-color) var(--ease);
  }

  .row:hover {
    background: var(--color-row-hover);
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
  }

  .title {
    font-family: var(--font-display);
    font-size: var(--fs-20);
    line-height: var(--lh-heading);
    color: var(--color-ink);
  }

  .meta {
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    color: var(--color-meta);
    white-space: nowrap;
  }

  .summary {
    font-family: var(--font-body);
    font-size: var(--fs-16);
    line-height: var(--lh-body-tight);
    color: var(--color-ink-desc);
    margin-top: var(--space-1);
    max-width: 60ch;
  }
</style>

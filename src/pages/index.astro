---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import CoordsReadout from '../components/CoordsReadout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import ProjectRow from '../components/ProjectRow.astro';
import NoteRow from '../components/NoteRow.astro';
import ExperienceRow from '../components/ExperienceRow.astro';
import { getSortedProjects } from '../lib/projects';
import { getPublishedNotes } from '../lib/notes';
import { site } from '../lib/site';
import logoImt from '../assets/logos/logo-imt.png';
import logoUpq from '../assets/logos/logo-upq.png';

const proyectos = await getSortedProjects();
const notas = await getPublishedNotes();
const hasNotas = notas.length > 0;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: 'Desarrollador de software',
  email: `mailto:${site.email}`,
  url: Astro.site?.toString(),
  address: { '@type': 'PostalAddress', addressLocality: site.location },
  sameAs: [site.github, site.linkedin],
};
---

<BaseLayout title={`${site.name} — Desarrollador de software`} description={site.description} jsonLd={jsonLd}>
  <Nav hasNotas={hasNotas} slot="nav" />
  <CoordsReadout />

  <div class="container">
    <section class="hero">
      <div class="grid-texture" aria-hidden="true"></div>
      <div class="eyebrow">§ 00<br />Perfil</div>
      <div>
        <h1><span class="plot">{site.name}</span></h1>
        <p class="tagline">{site.role}</p>
        <p class="location">{site.location} · Desarrollador en EOS Soluciones · .NET, Angular, SQL Server</p>
        <div class="hero-actions">
          <a class="cta" href="#proyectos">Ver proyectos <span class="arrow">→</span></a>
          <div class="social">
            <a class="link-draw" href={site.github} target="_blank" rel="noreferrer">GitHub</a>
            <a class="link-draw" href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
            <a class="link-draw" href={`mailto:${site.email}`}>Correo</a>
          </div>
        </div>
      </div>
    </section>

    <section class="wide" id="proyectos">
      <SectionLabel num="01" label="Selected work" />
      <div class="rows">
        {proyectos.map((p) => <ProjectRow entry={p} />)}
      </div>
    </section>

    <section id="sobre-mi">
      <div class="sidebar">
        <SectionLabel num="02" label="Sobre mí" />
        <div class="sidebar-facts">
          <div><span class="label">Ubicación</span><br />Querétaro, MX</div>
          <div><span class="label">Idiomas</span><br />Español (nativo)<br />Inglés (B2)</div>
          <a class="cv-link" href="/cv.pdf" data-astro-reload>CV en PDF ↓</a>
        </div>
      </div>
      <div>
        <h3>Me interesan los sistemas que la gente sigue usando todos los días.</h3>
        <p class="paragraph">
          La mayoría de mi trabajo ocurre sobre software que ya lleva años en producción: ERPs
          gubernamentales, sistemas financieros, plataformas internas que nadie puede darse el
          lujo de apagar. Ese es el problema que me gusta — no el proyecto en blanco, sino el
          que tiene diez años de decisiones encima y usuarios que dependen de él para trabajar.
        </p>
        <p class="paragraph">
          Trabajo documentando, no solo resolviendo. Un cambio que solo yo entiendo es deuda, no
          avance. Escribo para el equipo que viene después, rediseño interfaces sin romperle el
          hábito al usuario que ya sabe usarlas, y trato cada migración como una oportunidad de
          dejar el sistema más legible de como lo encontré.
        </p>
        <p class="paragraph">
          Busco equipos que traten el mantenimiento y la claridad como parte del oficio, no como
          un costo. Si tienes un sistema viejo que todavía importa, esa es exactamente la
          conversación que quiero tener.
        </p>
      </div>
    </section>

    <section id="experiencia">
      <SectionLabel num="03" label="Experiencia" />
      <div>
        <ExperienceRow
          period="2025 — hoy"
          company="EOS Soluciones"
          role="Desarrollador de Software"
          detail="Modernización de trámites de un ERP gubernamental (GeneXus 9→18 sobre .NET y Angular) y desarrollo de un ERP financiero para PyMEs con timbrado CFDI 4.0."
        />
        <ExperienceRow
          period="2024"
          company="IMT"
          role="Becario en Telemática"
          detail="Apoyo en infraestructura y sistemas de telemática."
          logo={logoImt}
          logoAlt="Instituto Mexicano del Transporte"
          logoHeight={22}
        />
        <ExperienceRow
          period="2023"
          company="UPQ"
          role="Becario en Soporte Técnico"
          detail="Soporte a usuarios y mantenimiento de equipo en la universidad."
          logo={logoUpq}
          logoAlt="Universidad Politécnica de Querétaro"
          logoHeight={34}
        />
        <div class="formacion-row">
          <div class="formacion-label">Formación</div>
          <div>
            <div class="formacion-degree">Ingeniería en Sistemas Computacionales</div>
            <div class="formacion-institution">Universidad Politécnica de Querétaro · Titulado 2026</div>
          </div>
        </div>
      </div>
    </section>

    {
      hasNotas && (
        <section id="notas">
          <SectionLabel num="04" label="Notas" />
          <div class="rows">
            {notas.map((n) => <NoteRow entry={n} />)}
          </div>
        </section>
      )
    }

    <section id="contacto" class="contacto">
      <SectionLabel num="05" label="Contacto" />
      <div>
        <h3>¿Tienes un sistema viejo que todavía importa? Hablemos.</h3>
        <p class="email">{site.email}</p>
        <div class="social">
          <a class="link-draw" href={site.github} target="_blank" rel="noreferrer">GitHub ↗</a>
          <a class="link-draw" href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  section {
    display: grid;
    grid-template-columns: var(--col-margin) var(--col-text);
    gap: var(--grid-gap);
    border-top: 1px solid var(--color-border);
  }

  section.wide {
    grid-template-columns: var(--col-margin) var(--col-wide);
  }

  .hero {
    position: relative;
    border-top: none;
    /* 128/112: valores literales del mockup (128 = --space-8) */
    padding: 128px 0 112px;
  }

  /* Papel milimetrado sutil detrás del hero — referencia directa al
     concepto "documentación técnica": el fondo de un plano, no decoración
     genérica. Se apaga con la máscara antes de tocar el texto. */
  .grid-texture {
    position: absolute;
    inset: -40px -40px auto -40px;
    height: 420px;
    background-image:
      linear-gradient(color-mix(in oklab, var(--color-accent) 6%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in oklab, var(--color-accent) 6%, transparent) 1px, transparent 1px);
    background-size: 32px 32px;
    -webkit-mask-image: radial-gradient(ellipse 900px 380px at 12% 15%, black, transparent 72%);
    mask-image: radial-gradient(ellipse 900px 380px at 12% 15%, black, transparent 72%);
    pointer-events: none;
  }

  /* Entrada de una sola vez al cargar — nunca disparada por scroll.
     El titular se traza como un plóter; el resto sube en cascada corta
     para no retrasar el LCP. prefers-reduced-motion (base.css) anula
     `animation` por completo y el estado de reposo ya es visible. */
  .hero h1 .plot {
    display: inline-block;
    clip-path: inset(0 100% 0 0);
    animation: plot 480ms cubic-bezier(0.65, 0, 0.35, 1) both;
  }
  @keyframes plot {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  .hero .tagline,
  .hero .location,
  .hero .hero-actions {
    animation: rise 380ms cubic-bezier(0.2, 0.7, 0.3, 1) both;
  }
  .hero .tagline {
    animation-delay: 120ms;
  }
  .hero .location {
    animation-delay: 190ms;
  }
  .hero .hero-actions {
    animation-delay: 260ms;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #proyectos {
    /* 80px: valor literal del mockup, fuera de la escala de 9 pasos */
    padding: 80px 0;
  }

  #sobre-mi,
  #experiencia,
  #notas {
    padding: var(--space-7) 0;
  }

  .contacto {
    /* 112px: valor literal del mockup */
    padding: var(--space-7) 0 112px;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    letter-spacing: 0.08em;
    color: var(--color-meta);
    line-height: var(--lh-meta);
  }

  h1 {
    font-size: var(--fs-61);
    line-height: var(--lh-display);
    letter-spacing: -0.005em;
    max-width: 12ch;
  }

  .tagline {
    font-family: var(--font-body);
    font-size: var(--fs-20);
    line-height: var(--lh-body-lg);
    color: var(--color-ink);
    margin-top: var(--space-4);
    max-width: 34ch;
  }

  .location {
    font-family: var(--font-mono);
    font-size: var(--fs-13);
    letter-spacing: 0.02em;
    color: var(--color-meta);
    line-height: var(--lh-meta);
    margin-top: var(--space-3);
  }

  .hero-actions {
    margin-top: var(--space-5);
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .cta {
    font-family: var(--font-body);
    font-size: var(--fs-16);
    color: var(--color-accent);
    border-bottom: 1.5px solid var(--color-accent);
    padding-bottom: 3px;
    display: inline-flex;
    align-items: center;
    transition: opacity var(--duration-opacity) var(--ease);
  }

  .cta:hover {
    opacity: 0.62;
  }

  .cta .arrow {
    display: inline-block;
    transition: transform var(--duration-opacity) cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .cta:hover .arrow {
    transform: translateX(5px);
  }

  .social {
    display: flex;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--fs-13);
  }

  .social a {
    color: var(--color-meta);
    transition: color var(--duration-color) var(--ease);
  }

  .social a:hover {
    color: var(--color-accent);
  }

  .rows {
    border-bottom: 1px solid var(--color-border);
  }

  .sidebar-facts {
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--color-ink-body);
  }

  .label {
    color: var(--color-meta);
  }

  .cv-link {
    color: var(--color-accent);
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 2px;
    width: fit-content;
    transition: opacity var(--duration-color) var(--ease);
  }

  .cv-link:hover {
    opacity: 0.62;
  }

  h3 {
    font-size: var(--fs-31);
    line-height: var(--lh-heading);
    max-width: 22ch;
    margin-bottom: var(--space-4);
  }

  .paragraph {
    font-family: var(--font-body);
    font-size: var(--fs-16);
    line-height: var(--lh-body);
    color: var(--color-ink-body);
    max-width: 68ch;
  }

  .paragraph + .paragraph {
    margin-top: var(--space-3);
  }

  .formacion-row {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
  }

  .formacion-label {
    font-family: var(--font-mono);
    font-size: var(--fs-13);
    color: var(--color-meta);
    padding-top: 4px;
  }

  .formacion-degree {
    font-family: var(--font-display);
    font-size: var(--fs-20);
    color: var(--color-ink);
  }

  .formacion-institution {
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    letter-spacing: 0.04em;
    color: var(--color-meta);
    margin-top: var(--space-1);
  }

  .email {
    font-family: var(--font-mono);
    font-size: var(--fs-16);
    color: var(--color-ink);
    user-select: all;
  }

  .contacto .social {
    margin-top: var(--space-4);
  }

  @media (max-width: 768px) {
    section,
    section.wide {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    h1 {
      font-size: var(--fs-39);
    }

    .hero {
      padding: var(--space-6) 0 var(--space-5);
    }
  }
</style>
